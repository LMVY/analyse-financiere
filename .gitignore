# ============================================================
# .gitignore - Analyse Financiere
# ============================================================

# --- Environnements Python ---
venv/
.conda/
env/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Donnees (trop volumineuses) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Config personnelle utilisateur ---
data/config_user.yaml

# --- Modeles serialises ---
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.json

# --- Fichiers de test temporaires ---
test.fec
test_excel.xlsx
*.tmp
test_memoire.txt
test_en_cours.txt
debug_page.png
*.png
!assets/*.png

# --- Backups ---
*.bak
*.backup
*.old
*_backup.py
*_body.py.broken

# --- Config locale et secrets ---
.env
.env.*
*.key

# --- Systeme ---
.DS_Store
Thumbs.db

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Logs ---
*.log
logs/

# --- Rapports generes ---
rapport_*.txt
verification.txt
