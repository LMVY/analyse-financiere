"""Parser FEC (Fichier des Ecritures Comptables).

Le FEC est un fichier obligatoire (DGFiP) qui contient TOUTES les
ecritures comptables. On agrege par numero de compte PCG pour
reconstituer le bilan et le compte de resultat.

Format FEC standard (18 colonnes) :
JournalCode|EcritureNum|EcritureDate|CompteNum|CompteLib|...|Debit|Credit|...
"""
import re
import yaml
from pathlib import Path
import pandas as pd


PCG_CONFIG_PATH = Path(__file__).parent.parent.parent / "config" / "pcg_referentiel.yaml"


def load_comptes_pcg():
    """Charge le mapping numero de compte -> code standard."""
    with open(PCG_CONFIG_PATH, "r", encoding="utf-8") as f:
        ref = yaml.safe_load(f)
    return ref.get("comptes_pcg", {})


def parse_montant(val):
    """Parse un montant FEC."""
    if val is None or pd.isna(val):
        return 0.0
    if isinstance(val, (int, float)):
        return float(val)
    cleaned = str(val).strip()
    if not cleaned:
        return 0.0
    # Virgule -> point
    cleaned = cleaned.replace(",", ".")
    cleaned = re.sub(r"[^\d.\-]", "", cleaned)
    if not cleaned or cleaned in "-." or cleaned == ".":
        return 0.0
    try:
        return float(cleaned)
    except ValueError:
        return 0.0


def read_fec(file_path):
    """Lit un fichier FEC (pipe, tab ou point-virgule)."""
    p = Path(file_path)
    if not p.exists():
        return None

    # Essayer plusieurs separateurs
    for sep in ["|", "\t", ";"]:
        try:
            df = pd.read_csv(p, sep=sep, dtype=str, encoding="utf-8")
            if df.shape[1] >= 5:
                return df
        except Exception:
            continue

    # Latin-1 (fichiers anciens)
    for sep in ["|", "\t", ";"]:
        try:
            df = pd.read_csv(p, sep=sep, dtype=str, encoding="latin1")
            if df.shape[1] >= 5:
                return df
        except Exception:
            continue

    return None


def find_column(df, candidates):
    """Trouve une colonne par nom (insensible casse/accents)."""
    cols_norm = {c.lower().strip(): c for c in df.columns}

    for cand in candidates:
        cand_lower = cand.lower()
        if cand_lower in cols_norm:
            return cols_norm[cand_lower]

    # Recherche partielle
    for cand in candidates:
        for col in df.columns:
            if cand.lower() in col.lower():
                return col

    return None


def find_pcg_code(compte_num, comptes_pcg):
    """Trouve le code standard a partir d'un numero de compte.

    Ex: "411000" -> "creances_clients" (via prefixe "411")
    """
    num = str(compte_num).strip()
    if not num:
        return None

    # Trier les prefixes du plus long au plus court
    matches = []
    for code_std, prefixes in comptes_pcg.items():
        for prefix in prefixes:
            prefix = str(prefix)
            if num.startswith(prefix):
                matches.append((len(prefix), code_std))

    if matches:
        matches.sort(reverse=True)
        return matches[0][1]

    return None


def extract_fec_values(file_path):
    """Extrait les valeurs d'un FEC.

    Returns:
        {"actif": {...}, "passif": {...}, "compte_resultat": {...}}
    """
    result = {"actif": {}, "passif": {}, "compte_resultat": {}}

    df = read_fec(file_path)
    if df is None:
        return result

    # Trouver les colonnes
    col_compte = find_column(df, ["CompteNum", "Compte", "NumeroCompte", "N° compte"])
    col_debit = find_column(df, ["Debit", "Débit", "DebitEuro"])
    col_credit = find_column(df, ["Credit", "Crédit", "CreditEuro"])
    col_libelle = find_column(df, ["CompteLib", "Libelle", "Libellé"])

    if not col_compte or not col_debit or not col_credit:
        print(f"  Colonnes manquantes : compte={col_compte}, debit={col_debit}, credit={col_credit}")
        return result

    # Charger le mapping PCG
    comptes_pcg = load_comptes_pcg()

    # Agreger par code standard
    soldes = {}
    for idx, row in df.iterrows():
        compte_num = str(row[col_compte]).strip()
        if not compte_num:
            continue

        debit = parse_montant(row[col_debit])
        credit = parse_montant(row[col_credit])
        solde = debit - credit

        code_std = find_pcg_code(compte_num, comptes_pcg)
        if not code_std:
            continue

        if code_std not in soldes:
            soldes[code_std] = 0.0
        soldes[code_std] += solde

    # Determiner la section pour chaque code
    # (on utilise les cles du referentiel)
    with open(PCG_CONFIG_PATH, "r", encoding="utf-8") as f:
        ref = yaml.safe_load(f)

    # Index : code -> section
    code_to_section = {}
    for section in ["actif", "passif", "compte_resultat"]:
        for code_std in ref.get(section, {}).keys():
            code_to_section[code_std] = section

    # Remplir le resultat
    for code_std, solde in soldes.items():
        section = code_to_section.get(code_std)
        if section:
            result[section][code_std] = solde

    return result


def detect_fec_format(file_path):
    """Verifie si le fichier est un FEC."""
    p = Path(file_path)
    if not p.exists():
        return False

    if p.suffix.lower() not in [".fec", ".txt", ".csv"]:
        return False

    # Verifier l'en-tete
    try:
        with open(p, "r", encoding="utf-8") as f:
            first_line = f.readline().lower()
            keywords = ["journalcode", "ecrituredate", "comptenum", "debit", "credit"]
            return sum(1 for kw in keywords if kw in first_line) >= 3
    except Exception:
        try:
            with open(p, "r", encoding="latin1") as f:
                first_line = f.readline().lower()
                keywords = ["journalcode", "ecrituredate", "comptenum", "debit", "credit"]
                return sum(1 for kw in keywords if kw in first_line) >= 3
        except Exception:
            return False


if __name__ == "__main__":
    import sys
    if len(sys.argv) < 2:
        print("Usage : python -m src.extraction.fec_parser fichier.fec")
        sys.exit(1)

    file_path = sys.argv[1]
    print(f"=== {file_path} ===")
    print(f"Format FEC : {detect_fec_format(file_path)}")
    print()

    data = extract_fec_values(file_path)

    for section in ["actif", "passif", "compte_resultat"]:
        print(f"--- {section.upper()} ({len(data[section])} postes) ---")
        for code, val in sorted(data[section].items()):
            if val:
                print(f"  {code:40s} : {val:>15,.0f}")
        print()
